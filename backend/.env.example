# =============================================================
# Karma Images Chatbot — Environment Variables
# =============================================================
# Copy this to .env and fill in your values

# Groq API Key (get free at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# PostgreSQL Connection URL
# Local Docker:  postgresql://karma:karma123@localhost:5432/karma_images
# Supabase:      postgresql://user:pass@host:5432/dbname
DATABASE_URL=postgresql://karma:karma123@localhost:5432/karma_images

# FastAPI Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# CORS - Frontend URL
FRONTEND_URL=http://localhost:5173
